{
  "description": "Kiln hooks for Gemini CLI (the Claude Code hooks, --runtime gemini). No-ops outside projects whose manifest.md says framework=kiln.",
  "hooks": {
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "kiln-guard-BeforeTool",
            "command": "node \"${extensionPath}${/}hooks${/}py.cjs\" \"${extensionPath}${/}hooks${/}guard.py\" --runtime gemini",
            "timeout": 10000
          }
        ],
        "matcher": "^(run_shell_command|write_file|replace|mcp_(blender|godot-ai|unity|unreal|unreal-mcp|unreal-mcp-proxy)_.*)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "name": "kiln-session-BeforeTool",
            "command": "node \"${extensionPath}${/}hooks${/}py.cjs\" \"${extensionPath}${/}hooks${/}session.py\" subagent --runtime gemini",
            "timeout": 10000
          }
        ],
        "matcher": "^invoke_agent$"
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "kiln-stop-AfterTool",
            "command": "node \"${extensionPath}${/}hooks${/}py.cjs\" \"${extensionPath}${/}hooks${/}stop.py\" subagent --runtime gemini",
            "timeout": 10000
          }
        ],
        "matcher": "^invoke_agent$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "kiln-session-SessionStart",
            "command": "node \"${extensionPath}${/}hooks${/}py.cjs\" \"${extensionPath}${/}hooks${/}session.py\" start --runtime gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "kiln-session-SessionEnd",
            "command": "node \"${extensionPath}${/}hooks${/}py.cjs\" \"${extensionPath}${/}hooks${/}session.py\" end --runtime gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "kiln-stop-AfterAgent",
            "command": "node \"${extensionPath}${/}hooks${/}py.cjs\" \"${extensionPath}${/}hooks${/}stop.py\" stop --runtime gemini",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
